-- The bag orbit theorem for the domain families, in guest mode: at each size n the orbits of the
-- configurations Pos n -> Choice under the word action are the bags of n choices.
def Choice : Type 0 := Sum Unit Unit

-- rebuild k e is e after one step of elim on the size, and rebuildPath is the path to e (funext of
-- rebuildEta). It gives the empty configuration at sz0 and the eta of consP at szS m.
def rebuild : (k : Size) -> (Pos k -> Choice) -> Pos k -> Choice :=
  fun (k : Size) => elim (fun (t : Size) => (Pos t -> Choice) -> Pos t -> Choice)
    (fun (e : Pos sz0 -> Choice) => fun (q : Pos sz0) => inl unit)
    (fun (m : Size) (ih : (Pos m -> Choice) -> Pos m -> Choice) => fun (e : Pos (szS m) -> Choice) => consP m (e (posFirst m)) (fun (p : Pos m) => e (posNext m p))) k
def rebuildEta : (k : Size) -> (q : Pos k) -> (e : Pos k -> Choice) -> Path Choice (rebuild k e q) (e q) :=
  fun (k : Size) (q : Pos k) => elim (fun (t : Size) (p : Pos t) => (e : Pos t -> Choice) -> Path Choice (rebuild t e p) (e p))
    (fun (m : Size) => fun (e : Pos (szS m) -> Choice) => refl)
    (fun (m : Size) (p : Pos m) (ih : (e : Pos m -> Choice) -> Path Choice (rebuild m e p) (e p)) => fun (e : Pos (szS m) -> Choice) => refl) q
def rebuildPath : (k : Size) -> (e : Pos k -> Choice) -> Path (Pos k -> Choice) (rebuild k e) e :=
  fun (k : Size) (e : Pos k -> Choice) => fun (i : I) => fun (q : Pos k) => rebuildEta k q e @ i

-- liftFront applies a word to the tail (consP, swapFront and actW are in domain.lang).
def liftFront : (m : Size) -> Word m -> (Pos (szS m) -> Choice) -> Pos (szS m) -> Choice :=
  fun (m : Size) (u : Word m) (d : Pos (szS m) -> Choice) => consP m (d (posFirst m)) (actW m u (fun (p : Pos m) => d (posNext m p)))

-- swapR is the relation of OrbitN (domain.lang), a set by its squash.
def swapR : (n : Size) -> (Pos n -> Choice) -> (Pos n -> Choice) -> Type 0 :=
  fun (n : Size) (c : Pos n -> Choice) (d : Pos n -> Choice) => Sigma (w : Word n) (Path (Pos n -> Choice) (actW n w d) c)
def isSetOrbitN : (k : Size) -> isSet (OrbitN k) :=
  fun (k : Size) (x : OrbitN k) (y : OrbitN k) (p : Path (OrbitN k) x y) (q : Path (OrbitN k) x y) =>
    fun (i : I) => fun (j : I) => orbitNSquash k x y p q i j
def isSetBag : (k : Size) -> isSet (ChoiceBag k) :=
  fun (k : Size) (x : ChoiceBag k) (y : ChoiceBag k) (p : Path (ChoiceBag k) x y) (q : Path (ChoiceBag k) x y) =>
    fun (i : I) => fun (j : I) => choiceSquash k x y p q i j

-- listB lists a configuration in position order. A word moves the list by one bag swap for each letter.
def listB : (k : Size) -> (Pos k -> Choice) -> ChoiceBag k :=
  fun (k : Size) => elim (fun (t : Size) => (Pos t -> Choice) -> ChoiceBag t)
    (fun (e : Pos sz0 -> Choice) => choiceNil)
    (fun (m : Size) (ih : (Pos m -> Choice) -> ChoiceBag m) => fun (e : Pos (szS m) -> Choice) => choiceCons m (e (posFirst m)) (ih (fun (p : Pos m) => e (posNext m p)))) k
def swapList : (m : Size) -> (c : Pos (szS (szS m)) -> Choice) -> Path (ChoiceBag (szS (szS m))) (listB (szS (szS m)) (swapFront m c)) (listB (szS (szS m)) c) :=
  fun (m : Size) (c : Pos (szS (szS m)) -> Choice) => fun (i : I) =>
    choiceSwap m (c (posNext (szS m) (posFirst m))) (c (posFirst (szS m))) (listB m (fun (p : Pos m) => c (posNext (szS m) (posNext m p)))) i
def listAct : (n : Size) -> (w : Word n) -> (d : Pos n -> Choice) -> Path (ChoiceBag n) (listB n (actW n w d)) (listB n d) :=
  fun (n : Size) (w : Word n) => elim (fun (k : Size) (v : Word k) => (d : Pos k -> Choice) -> Path (ChoiceBag k) (listB k (actW k v d)) (listB k d))
    (fun (k : Size) => fun (d : Pos k -> Choice) => refl)
    (fun (m : Size) (v : Word (szS (szS m))) (ih : (d : Pos (szS (szS m)) -> Choice) -> Path (ChoiceBag (szS (szS m))) (listB (szS (szS m)) (actW (szS (szS m)) v d)) (listB (szS (szS m)) d)) =>
      fun (d : Pos (szS (szS m)) -> Choice) =>
        trans (ChoiceBag (szS (szS m))) (listB (szS (szS m)) (swapFront m (actW (szS (szS m)) v d))) (listB (szS (szS m)) (actW (szS (szS m)) v d)) (listB (szS (szS m)) d)
          (swapList m (actW (szS (szS m)) v d)) (ih d))
    (fun (m : Size) (u : Word m) (ihu : (d : Pos m -> Choice) -> Path (ChoiceBag m) (listB m (actW m u d)) (listB m d))
      (v : Word (szS m)) (ihv : (d : Pos (szS m) -> Choice) -> Path (ChoiceBag (szS m)) (listB (szS m) (actW (szS m) v d)) (listB (szS m) d)) =>
      fun (d : Pos (szS m) -> Choice) =>
        trans (ChoiceBag (szS m)) (listB (szS m) (actW (szS m) v (liftFront m u d))) (listB (szS m) (liftFront m u d)) (listB (szS m) d)
          (ihv (liftFront m u d)) (fun (i : I) => choiceCons m (d (posFirst m)) (ihu (fun (p : Pos m) => d (posNext m p)) @ i))) w

-- toBag is an elim on OrbitN: the orbitNEq case is the path of r, then listAct on the word.
def toBag : (k : Size) -> OrbitN k -> ChoiceBag k :=
  fun (k : Size) (z : OrbitN k) => elim (fun (n : Size) (x : OrbitN n) => ChoiceBag n)
    (fun (n : Size) (c : Pos n -> Choice) => listB n c)
    (fun (n : Size) (c : Pos n -> Choice) (d : Pos n -> Choice) (r : swapR n c d) => fun (i : I) =>
      trans (ChoiceBag n) (listB n c) (listB n (actW n (witness r) d)) (listB n d) (sym (cong (listB n) (payload r))) (listAct n (witness r) d) @ i)
    (fun (n : Size) (w : OrbitN n) (ihw : ChoiceBag n) (v : OrbitN n) (ihv : ChoiceBag n)
      (p : Path (OrbitN n) w v) (ihp : Path (ChoiceBag n) ihw ihv) (q : Path (OrbitN n) w v) (ihq : Path (ChoiceBag n) ihw ihv) =>
      fun (i : I) => fun (j : I) => (isSetBag n ihw ihv ihp ihq @ i) @ j) z
-- consO puts a choice in front of an orbit. The orbitNEq case lifts the word of r to the tail.
def consO : (m : Size) -> Choice -> OrbitN m -> OrbitN (szS m) :=
  fun (m : Size) (a : Choice) (z : OrbitN m) => elim (fun (n : Size) (x : OrbitN n) => OrbitN (szS n))
    (fun (n : Size) (c : Pos n -> Choice) => orbitNOf (szS n) (consP n a c))
    (fun (n : Size) (c : Pos n -> Choice) (d : Pos n -> Choice) (r : swapR n c d) =>
      fun (i : I) => orbitNEq (szS n) (consP n a c) (consP n a d)
        (pack (wordLift n (witness r) (wordNil (szS n))) (fun (j : I) => consP n a (payload r @ j))) i)
    (fun (n : Size) (w : OrbitN n) (ihw : OrbitN (szS n)) (v : OrbitN n) (ihv : OrbitN (szS n))
      (p : Path (OrbitN n) w v) (ihp : Path (OrbitN (szS n)) ihw ihv) (q : Path (OrbitN n) w v) (ihq : Path (OrbitN (szS n)) ihw ihv) =>
      fun (i : I) => fun (j : I) => (isSetOrbitN (szS n) ihw ihv ihp ihq @ i) @ j) z

-- A family of propositions over a path or a square has each PathP.
def propOver : (X : Type 0) -> (P : X -> Type 0) -> ((x : X) -> isProp (P x)) -> (a : X) -> (b : X) -> (q : Path X a b) -> (u : P a) -> (v : P b) -> PathP (fun (i : I) => P (q @ i)) u v :=
  fun (X : Type 0) (P : X -> Type 0) (hP : (x : X) -> isProp (P x)) (a : X) (b : X) (q : Path X a b) (u : P a) (v : P b) =>
    fun (i : I) => hcomp (P (q @ i)) (~i \/ i) (fun (k : I) => [
      ~i -> hP (q @ i) (transp (fun (m : I) => P (q @ (i /\ m))) i0 u) u @ k,
      i -> hP (q @ i) (transp (fun (m : I) => P (q @ (i /\ m))) i0 u) v @ k ]) (transp (fun (m : I) => P (q @ (i /\ m))) i0 u)
def propSquare : (X : Type 0) -> (P : X -> Type 0) -> ((x : X) -> isProp (P x)) -> (x : X) -> (y : X) -> (p : Path X x y) -> (q : Path X x y) -> (s : Path (Path X x y) p q) ->
  (ihx : P x) -> (ihy : P y) -> (ihp : PathP (fun (j : I) => P (p @ j)) ihx ihy) -> (ihq : PathP (fun (j : I) => P (q @ j)) ihx ihy) ->
  PathP (fun (i : I) => PathP (fun (j : I) => P ((s @ i) @ j)) ihx ihy) ihp ihq :=
  fun (X : Type 0) (P : X -> Type 0) (hP : (x : X) -> isProp (P x)) (x : X) (y : X) (p : Path X x y) (q : Path X x y) (s : Path (Path X x y) p q)
    (ihx : P x) (ihy : P y) (ihp : PathP (fun (j : I) => P (p @ j)) ihx ihy) (ihq : PathP (fun (j : I) => P (q @ j)) ihx ihy) =>
    fun (i : I) => fun (j : I) => hcomp (P ((s @ i) @ j)) (~i \/ i \/ ~j \/ j) (fun (k : I) => [
      ~i -> hP ((s @ i) @ j) (transp (fun (m : I) => P ((s @ (i /\ m)) @ (j /\ m))) i0 ihx) (ihp @ j) @ k,
      i -> hP ((s @ i) @ j) (transp (fun (m : I) => P ((s @ (i /\ m)) @ (j /\ m))) i0 ihx) (ihq @ j) @ k,
      ~j -> hP ((s @ i) @ j) (transp (fun (m : I) => P ((s @ (i /\ m)) @ (j /\ m))) i0 ihx) ihx @ k,
      j -> hP ((s @ i) @ j) (transp (fun (m : I) => P ((s @ (i /\ m)) @ (j /\ m))) i0 ihx) ihy @ k ])
      (transp (fun (m : I) => P ((s @ (i /\ m)) @ (j /\ m))) i0 ihx)

-- Two maps into a set agree on OrbitN when they agree at orbitNOf, and two
-- maps of bags agree when they agree at choiceNil and the choiceCons case follows. The set proofs and the maps
-- are variables, so the motive does not unfold them at the squash case.
def orbitNExt : (T : Size -> Type 0) -> ((n : Size) -> isSet (T n)) -> (L : (n : Size) -> OrbitN n -> T n) -> (M : (n : Size) -> OrbitN n -> T n) ->
  ((n : Size) -> (c : Pos n -> Choice) -> Path (T n) (L n (orbitNOf n c)) (M n (orbitNOf n c))) -> (k : Size) -> (x : OrbitN k) -> Path (T k) (L k x) (M k x) :=
  fun (T : Size -> Type 0) (sT : (n : Size) -> isSet (T n)) (L : (n : Size) -> OrbitN n -> T n) (M : (n : Size) -> OrbitN n -> T n)
    (h : (n : Size) -> (c : Pos n -> Choice) -> Path (T n) (L n (orbitNOf n c)) (M n (orbitNOf n c))) (k : Size) (x : OrbitN k) =>
    elim (fun (n : Size) (z : OrbitN n) => Path (T n) (L n z) (M n z))
      (fun (n : Size) (c : Pos n -> Choice) => h n c)
      (fun (n : Size) (a : Pos n -> Choice) (b : Pos n -> Choice) (r : swapR n a b) => fun (i : I) =>
        propOver (OrbitN n) (fun (z : OrbitN n) => Path (T n) (L n z) (M n z)) (fun (z : OrbitN n) => sT n (L n z) (M n z))
          (orbitNOf n a) (orbitNOf n b) (fun (e : I) => orbitNEq n a b r e) (h n a) (h n b) @ i)
      (fun (n : Size) (w : OrbitN n) (ihw : Path (T n) (L n w) (M n w)) (y : OrbitN n) (ihy : Path (T n) (L n y) (M n y))
        (p : Path (OrbitN n) w y) (ihp : PathP (fun (j : I) => Path (T n) (L n (p @ j)) (M n (p @ j))) ihw ihy)
        (q : Path (OrbitN n) w y) (ihq : PathP (fun (j : I) => Path (T n) (L n (q @ j)) (M n (q @ j))) ihw ihy) =>
        fun (i : I) => fun (j : I) => (propSquare (OrbitN n) (fun (z : OrbitN n) => Path (T n) (L n z) (M n z)) (fun (z : OrbitN n) => sT n (L n z) (M n z))
          w y p q (fun (m : I) => fun (o : I) => orbitNSquash n w y p q m o) ihw ihy ihp ihq @ i) @ j) x
def bagExt : (sB : (k : Size) -> isSet (ChoiceBag k)) -> (L : (k : Size) -> ChoiceBag k -> ChoiceBag k) -> (M : (k : Size) -> ChoiceBag k -> ChoiceBag k) ->
  Path (ChoiceBag sz0) (L sz0 (choiceNil)) (M sz0 (choiceNil)) ->
  ((m : Size) -> (a : Choice) -> (t : ChoiceBag m) -> Path (ChoiceBag m) (L m t) (M m t) -> Path (ChoiceBag (szS m)) (L (szS m) (choiceCons m a t)) (M (szS m) (choiceCons m a t))) ->
  (k : Size) -> (y : ChoiceBag k) -> Path (ChoiceBag k) (L k y) (M k y) :=
  fun (sB : (k : Size) -> isSet (ChoiceBag k)) (L : (k : Size) -> ChoiceBag k -> ChoiceBag k) (M : (k : Size) -> ChoiceBag k -> ChoiceBag k)
    (hNil : Path (ChoiceBag sz0) (L sz0 (choiceNil)) (M sz0 (choiceNil)))
    (hCons : (m : Size) -> (a : Choice) -> (t : ChoiceBag m) -> Path (ChoiceBag m) (L m t) (M m t) -> Path (ChoiceBag (szS m)) (L (szS m) (choiceCons m a t)) (M (szS m) (choiceCons m a t)))
    (k : Size) (y : ChoiceBag k) =>
    elim (fun (n : Size) (z : ChoiceBag n) => Path (ChoiceBag n) (L n z) (M n z))
      hNil
      (fun (m : Size) (a : Choice) (t : ChoiceBag m) (ih : Path (ChoiceBag m) (L m t) (M m t)) => hCons m a t ih)
      (fun (m : Size) (a : Choice) (b : Choice) (t : ChoiceBag m) (ih : Path (ChoiceBag m) (L m t) (M m t)) => fun (i : I) =>
        propOver (ChoiceBag (szS (szS m))) (fun (z : ChoiceBag (szS (szS m))) => Path (ChoiceBag (szS (szS m))) (L (szS (szS m)) z) (M (szS (szS m)) z))
          (fun (z : ChoiceBag (szS (szS m))) => sB (szS (szS m)) (L (szS (szS m)) z) (M (szS (szS m)) z))
          (choiceCons (szS m) a (choiceCons m b t)) (choiceCons (szS m) b (choiceCons m a t)) (fun (k : I) => choiceSwap m a b t k)
          (hCons (szS m) a (choiceCons m b t) (hCons m b t ih)) (hCons (szS m) b (choiceCons m a t) (hCons m a t ih)) @ i)
      (fun (n : Size) (w : ChoiceBag n) (ihw : Path (ChoiceBag n) (L n w) (M n w)) (v : ChoiceBag n) (ihv : Path (ChoiceBag n) (L n v) (M n v))
        (p : Path (ChoiceBag n) w v) (ihp : PathP (fun (j : I) => Path (ChoiceBag n) (L n (p @ j)) (M n (p @ j))) ihw ihv)
        (q : Path (ChoiceBag n) w v) (ihq : PathP (fun (j : I) => Path (ChoiceBag n) (L n (q @ j)) (M n (q @ j))) ihw ihv) =>
        fun (i : I) => fun (j : I) => (propSquare (ChoiceBag n) (fun (z : ChoiceBag n) => Path (ChoiceBag n) (L n z) (M n z)) (fun (z : ChoiceBag n) => sB n (L n z) (M n z))
          w v p q (fun (m : I) => fun (o : I) => choiceSquash n w v p q m o) ihw ihv ihp ihq @ i) @ j) y

-- fromBagW sw is elim on ChoiceBag. The choiceSwap case is sw, and the choiceSquash case is isSetOrbitN. swapO is a swap
-- case: a path in OrbitN by orbitNExt and the word that swaps the first two positions. fromBag is fromBagW swapO.
-- The kernel compares two closures by eta, so each comparison of two fromBag values unfolds swapO and does
-- not fit in the arena. A variable sw keeps these comparisons small.
def SwapCase : Type 0 := (m : Size) -> (a : Choice) -> (b : Choice) -> (x : OrbitN m) ->
  Path (OrbitN (szS (szS m))) (consO (szS m) a (consO m b x)) (consO (szS m) b (consO m a x))
def swapO : SwapCase :=
  fun (m : Size) (a : Choice) (b : Choice) (x : OrbitN m) =>
    orbitNExt (fun (n : Size) => OrbitN (szS (szS n))) (fun (n : Size) => isSetOrbitN (szS (szS n)))
      (fun (n : Size) (z : OrbitN n) => consO (szS n) a (consO n b z)) (fun (n : Size) (z : OrbitN n) => consO (szS n) b (consO n a z))
      (fun (n : Size) (c : Pos n -> Choice) => fun (i : I) => orbitNEq (szS (szS n))
        (consP (szS n) a (consP n b c)) (consP (szS n) b (consP n a c)) (pack (wordSwap n (wordNil (szS (szS n)))) refl) i) m x
def fromBagW : SwapCase -> (k : Size) -> ChoiceBag k -> OrbitN k :=
  fun (sw : SwapCase) (k : Size) (y : ChoiceBag k) => elim (fun (n : Size) (z : ChoiceBag n) => OrbitN n)
    (orbitNOf sz0 (fun (q : Pos sz0) => inl unit))
    (fun (m : Size) (a : Choice) (t : ChoiceBag m) (ih : OrbitN m) => consO m a ih)
    (fun (m : Size) (a : Choice) (b : Choice) (t : ChoiceBag m) (ih : OrbitN m) => fun (i : I) => sw m a b ih @ i)
    (fun (n : Size) (w : ChoiceBag n) (ihw : OrbitN n) (v : ChoiceBag n) (ihv : OrbitN n)
      (p : Path (ChoiceBag n) w v) (ihp : Path (OrbitN n) ihw ihv) (q : Path (ChoiceBag n) w v) (ihq : Path (OrbitN n) ihw ihv) =>
      fun (i : I) => fun (j : I) => (isSetOrbitN n ihw ihv ihp ihq @ i) @ j) y
def fromBag : (k : Size) -> ChoiceBag k -> OrbitN k := fromBagW swapO

-- The two homotopies hold for each map G with the choiceNil and choiceCons rules of fromBag. G is a variable,
-- so a motive does not unfold fromBag (the elim of fromBag at a stuck bag is too large for the arena).
def NilRule : ((k : Size) -> ChoiceBag k -> OrbitN k) -> Type 0 :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) => Path (OrbitN sz0) (G sz0 (choiceNil)) (orbitNOf sz0 (fun (q : Pos sz0) => inl unit))
def ConsRule : ((k : Size) -> ChoiceBag k -> OrbitN k) -> Type 0 :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) => (m : Size) -> (a : Choice) -> (t : ChoiceBag m) -> Path (OrbitN (szS m)) (G (szS m) (choiceCons m a t)) (consO m a (G m t))

-- G after toBag is the identity: at orbitNOf by elim on the size (the nil rule and rebuildPath at sz0, the
-- cons rule, consO of the hypothesis and rebuildPath at szS m), then by orbitNExt.
def fromToQuot : (G : (k : Size) -> ChoiceBag k -> OrbitN k) -> NilRule G -> ConsRule G -> (k : Size) -> (c : Pos k -> Choice) -> Path (OrbitN k) (G k (listB k c)) (orbitNOf k c) :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) (hN : NilRule G) (hC : ConsRule G) (k : Size) =>
    elim (fun (t : Size) => (c : Pos t -> Choice) -> Path (OrbitN t) (G t (listB t c)) (orbitNOf t c))
    (fun (c : Pos sz0 -> Choice) => trans (OrbitN sz0) (G sz0 (listB sz0 c)) (orbitNOf sz0 (rebuild sz0 c)) (orbitNOf sz0 c)
      hN (fun (i : I) => orbitNOf sz0 (rebuildPath sz0 c @ i)))
    (fun (m : Size) (ih : (c : Pos m -> Choice) -> Path (OrbitN m) (G m (listB m c)) (orbitNOf m c)) => fun (c : Pos (szS m) -> Choice) =>
      trans (OrbitN (szS m)) (G (szS m) (listB (szS m) c)) (consO m (c (posFirst m)) (G m (listB m (fun (p : Pos m) => c (posNext m p))))) (orbitNOf (szS m) c)
        (hC m (c (posFirst m)) (listB m (fun (p : Pos m) => c (posNext m p))))
        (trans (OrbitN (szS m)) (consO m (c (posFirst m)) (G m (listB m (fun (p : Pos m) => c (posNext m p))))) (orbitNOf (szS m) (rebuild (szS m) c)) (orbitNOf (szS m) c)
          (fun (i : I) => consO m (c (posFirst m)) (ih (fun (p : Pos m) => c (posNext m p)) @ i))
          (fun (i : I) => orbitNOf (szS m) (rebuildPath (szS m) c @ i)))) k
def fromTo : (G : (k : Size) -> ChoiceBag k -> OrbitN k) -> NilRule G -> ConsRule G -> (k : Size) -> (x : OrbitN k) -> Path (OrbitN k) (G k (toBag k x)) x :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) (hN : NilRule G) (hC : ConsRule G) (k : Size) (x : OrbitN k) =>
    orbitNExt (fun (n : Size) => OrbitN n) isSetOrbitN (fun (n : Size) (z : OrbitN n) => G n (toBag n z)) (fun (n : Size) (z : OrbitN n) => z) (fromToQuot G hN hC) k x

-- toBag after fromBag is the identity: toBag of consO is choiceCons (refl at orbitNOf), then bagExt.
def toCons : (m : Size) -> (a : Choice) -> (x : OrbitN m) -> Path (ChoiceBag (szS m)) (toBag (szS m) (consO m a x)) (choiceCons m a (toBag m x)) :=
  fun (m : Size) (a : Choice) (x : OrbitN m) =>
    orbitNExt (fun (n : Size) => ChoiceBag (szS n)) (fun (n : Size) => isSetBag (szS n))
      (fun (n : Size) (z : OrbitN n) => toBag (szS n) (consO n a z)) (fun (n : Size) (z : OrbitN n) => choiceCons n a (toBag n z)) (fun (n : Size) (c : Pos n -> Choice) => refl) m x
def toFrom : (G : (k : Size) -> ChoiceBag k -> OrbitN k) -> NilRule G -> ConsRule G -> (k : Size) -> (y : ChoiceBag k) -> Path (ChoiceBag k) (toBag k (G k y)) y :=
  fun (G : (k : Size) -> ChoiceBag k -> OrbitN k) (hN : NilRule G) (hC : ConsRule G) (k : Size) (y : ChoiceBag k) =>
    bagExt isSetBag (fun (n : Size) (z : ChoiceBag n) => toBag n (G n z)) (fun (n : Size) (z : ChoiceBag n) => z)
      (fun (i : I) => toBag sz0 (hN @ i))
      (fun (m : Size) (a : Choice) (t : ChoiceBag m) (ih : Path (ChoiceBag m) (toBag m (G m t)) t) =>
        trans (ChoiceBag (szS m)) (toBag (szS m) (G (szS m) (choiceCons m a t))) (toBag (szS m) (consO m a (G m t))) (choiceCons m a t)
          (fun (i : I) => toBag (szS m) (hC m a t @ i))
          (trans (ChoiceBag (szS m)) (toBag (szS m) (consO m a (G m t))) (choiceCons m a (toBag m (G m t))) (choiceCons m a t)
            (toCons m a (G m t)) (fun (i : I) => choiceCons m a (ih @ i)))) k y

-- fromBagW sw has the two rules by the elim rule. bagOrbitW holds at each swap case sw. The theorem: the
-- orbits at size k are the bags of k choices, with fromBag as the inverse. Its type does not name sw.
def fromBagNil : (sw : SwapCase) -> NilRule (fromBagW sw) := fun (sw : SwapCase) => refl
def fromBagCons : (sw : SwapCase) -> ConsRule (fromBagW sw) := fun (sw : SwapCase) (m : Size) (a : Choice) (t : ChoiceBag m) => refl
def bagOrbitW : SwapCase -> (k : Size) -> Equiv (OrbitN k) (ChoiceBag k) :=
  fun (sw : SwapCase) (k : Size) => isoToEquiv (OrbitN k) (ChoiceBag k) (toBag k) (fromBagW sw k)
    (toFrom (fromBagW sw) (fromBagNil sw) (fromBagCons sw) k) (fromTo (fromBagW sw) (fromBagNil sw) (fromBagCons sw) k)
def bagOrbit : (k : Size) -> Equiv (OrbitN k) (ChoiceBag k) := bagOrbitW swapO
