-- Entries: first-order Nat and Flag definitions. The target exports them.
def addPrice : (a : Nat) -> (b : Nat) -> Option Nat := fun (a : Nat) (b : Nat) => natAdd a b
def ratio : (a k : Nat) -> Option Nat := fun (a k : Nat) => map (fun (d : NonZero Nat) => natDiv a d) (nonZero k)
def remainder : (a k : Nat) -> Option Nat := fun (a k : Nat) => map (fun (d : NonZero Nat) => natMod a d) (nonZero k)
def discount : (a d : Nat) -> Nat := fun (a d : Nat) => natSub a d
def cheap : (a : Nat) -> Flag := fun (a : Nat) => natLe a 100
def square : (n : Nat) -> Option Nat := fun (n : Nat) => fold (fun (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a n)) (some 0) n
def pick : (f : Flag) -> (a b : Nat) -> Nat := fun (f : Flag) (a b : Nat) => flagIf f a b
-- Shared values exercise reuse in a block, in sibling branches and in a
-- deep graph. Addition overflow returns the explicit fallback value 0.
def sharedDouble : Nat -> Nat := fun (t : Nat) => option 0 (fun (x : Nat) => x) (natAdd t t)
def shareTwice : Nat -> Nat := fun (u : Nat) => (fun (t : Nat) => sharedDouble t) (natSub u 1)
def shareArms : (u v : Nat) -> Nat := fun (u v : Nat) =>
  (fun (t : Nat) => flagIf (natEq u 0) t (option 0 (fun (x : Nat) => x) (natAdd t 1))) (natSub v 1)
def shareDeep : Nat -> Nat := fun (u : Nat) => sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble (sharedDouble u)))))))))))))))
