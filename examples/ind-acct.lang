-- The Ind matrix (S5 unit 5, Q-S5-32 (a)): a dep pair. Each Pay writes the one Total key, so two Pays do not commute.
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Total : Size -> Key
def gen : Size := sz0
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from), Total(gen)] writes [Bal(b.to), Total(gen)]
