-- traceEval (S6 u5c): the eval of a trace applies the step of each letter
-- from the left. The eval of traceEps is just. effRun runs an eval on the
-- fixed state s0. The swap row: the path traceEval (tSwap @ i) goes from
-- the eval of tTwo to the eval of tSwap @ i1.
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Vote : Size -> Key
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from)] writes [Bal(b.to)]
family Cast := mkcast (voter : Size) footprint b reads [Vote(b.voter)] writes [Vote(b.voter)]
def pay0 : Body := bodyPay (mk sz0 (szS sz0))
def cast0 : Body := bodyCast (mkcast sz0)
def s0 : State := fun (k : Key) => sz0
def tTwo : Trace := traceCons pay0 (traceCons cast0 traceEps)
def tSwap : Path Trace tTwo (traceCons cast0 (traceCons pay0 traceEps)) :=
  fun (i : I) => traceSwap pay0 cast0 traceEps refl i
def eEps : Path Eff (traceEval traceEps) just := refl
def eOne : (a : Body) -> Path Eff (traceEval (traceOne a)) (effSeq (step a) just) := fun (a : Body) => refl
def eTwo : Path Eff (traceEval tTwo) (effSeq (step pay0) (effSeq (step cast0) just)) := refl
def eSwapEnd : Path Eff (traceEval (tSwap @ i1)) (effSeq (step cast0) (effSeq (step pay0) just)) := refl
def eSwap : Path Eff (traceEval tTwo) (traceEval (tSwap @ i1)) := fun (i : I) => traceEval (tSwap @ i)
def rEps : Val := effRun (traceEval traceEps) s0 (Bal sz0)
def rTwo : Val := effRun (traceEval tTwo) s0 (Bal sz0)
def rSwap : Val := effRun (traceEval (tSwap @ i1)) s0 (Bal sz0)
def rSwapPath : Path Val rTwo rSwap := fun (i : I) => effRun (eSwap @ i) s0 (Bal sz0)
