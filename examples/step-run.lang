-- The front end makes the def stepPay : Pay -> Eff from the step of Pay (Q-S5-26 (a), Q-S5-27 (a)). effRun runs it on the state s0.
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Cfg : Size -> Size -> Key
def lim : Size := szS sz0
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from), Bal(b.to), Cfg(b.to, lim)] writes [Bal(b.to)]
step Pay p := [get x := Bal(p.from), get z := Cfg(p.to, lim), let y := x, set Bal(p.to) := y]
def pk : Key := Bal (to (mk sz0 lim))
def s0 : State := fun (k : Key) => elim (fun (t : Key) => Val) (fun (a : Size) => a) (fun (a : Size) (c : Size) => szS c) k
def two : Size := szS (szS sz0)
def r1 : Val := effRun (stepPay (mk two sz0)) s0 (Bal sz0)
def r2 : Val := effRun (stepPay (mk two sz0)) s0 (Bal lim)
def r3 : Val := effRun (stepPay (mk two sz0)) s0 (Bal two)
def r4 : Val := effRun (stepPay (mk sz0 lim)) s0 (Bal lim)
