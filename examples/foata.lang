-- foata, foataPeel and foataEq (S7 u5a2, Q-S7-4 (a), Q-S7-7 (a), Q-S7-13 (a)):
-- the front end puts foataPeel and foata (the Foata steps of a list of
-- bodies, by ind) after traceAppend, and foataEq (equal steps as bags, by
-- bodyEq) after bodyEqSound. The Pay text and the slot commutePayPay are
-- examples/commute-if.lang, thus the Pay and Pay row is ind-if. Pay and
-- Cast use different key spaces, thus ind is flagYes for each Pay and Cast
-- pair. Cast has no slot, thus two Cast bodies are a dep pair.
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Vote : Size -> Key
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from)] writes [Bal(b.to)]
family Cast := mkcast (voter : Size) footprint b reads [Vote(b.voter)] writes [Vote(b.voter)]
step Pay p := [get x := Bal(p.from), set Bal(p.to) := x]
def keyApart : Key -> Key -> Flag := fun (k : Key) (l : Key) => flagIf (keyEq k l) flagNo flagYes
def flagBoth : Flag -> Flag -> Flag := fun (p : Flag) (q : Flag) => flagIf p q flagNo
def swapKill : (pu : Flag) -> Path Flag (flagIf pu flagNo flagYes) flagYes -> Path Flag pu flagYes -> Path Flag flagNo flagYes := fun (pu : Flag) (phc : Path Flag (flagIf pu flagNo flagYes) flagYes) (pe : Path Flag pu flagYes) => subst Flag (fun (pt : Flag) => Path Flag (flagIf pt flagNo flagYes) flagYes) pu flagYes pe phc
def keySym : (pk : Key) -> (pl : Key) -> Path Flag (keyEq pk pl) flagYes -> Path Flag (keyEq pl pk) flagYes := fun (pk : Key) (pl : Key) (pe : Path Flag (keyEq pk pl) flagYes) => subst Key (fun (px : Key) => Path Flag (keyEq px pk) flagYes) pk pl (keyEqSound pk pl pe) (keyEqRefl pk)
def keyMeet : (pk : Key) -> (pB : Key) -> (pD : Key) -> Path Flag (keyEq pk pD) flagYes -> Path Flag (keyEq pk pB) flagYes -> Path Flag (keyEq pB pD) flagYes := fun (pk : Key) (pB : Key) (pD : Key) (pe1 : Path Flag (keyEq pk pD) flagYes) (pe2 : Path Flag (keyEq pk pB) flagYes) => subst Key (fun (px : Key) => Path Flag (keyEq pB px) flagYes) pk pD (keyEqSound pk pD pe1) (keySym pk pB pe2)
def valCase : (pu : Flag) -> (Path Flag pu flagYes -> Path Flag flagNo flagYes) -> (pa : Val) -> (pc : Val) -> Path Val (flagIf pu pa pc) pc := fun (pu : Flag) (pn : Path Flag pu flagYes -> Path Flag flagNo flagYes) (pa : Val) (pc : Val) => elim (fun (pt : Flag) => (Path Flag pt flagYes -> Path Flag flagNo flagYes) -> Path Val (flagIf pt pa pc) pc) (fun (pm : Path Flag flagYes flagYes -> Path Flag flagNo flagYes) => flagAbsurd Val pa pc (pm refl)) (fun (pm : Path Flag flagNo flagYes -> Path Flag flagNo flagYes) => refl) pu pn
def valCaseR : (pu : Flag) -> (Path Flag pu flagYes -> Path Flag flagNo flagYes) -> (pa : Val) -> (pc : Val) -> Path Val pc (flagIf pu pa pc) := fun (pu : Flag) (pn : Path Flag pu flagYes -> Path Flag flagNo flagYes) (pa : Val) (pc : Val) => elim (fun (pt : Flag) => (Path Flag pt flagYes -> Path Flag flagNo flagYes) -> Path Val pc (flagIf pt pa pc)) (fun (pm : Path Flag flagYes flagYes -> Path Flag flagNo flagYes) => flagAbsurd Val pc pa (pm refl)) (fun (pm : Path Flag flagNo flagYes -> Path Flag flagNo flagYes) => refl) pu pn
def valPoint : (pu1 : Flag) -> (pu2 : Flag) -> (pu3 : Flag) -> (pu4 : Flag) -> (Path Flag pu1 flagYes -> Path Flag pu2 flagYes -> Path Flag flagNo flagYes) -> (Path Flag pu3 flagYes -> Path Flag flagNo flagYes) -> (Path Flag pu4 flagYes -> Path Flag flagNo flagYes) -> (pa : Val) -> (pc : Val) -> (pk : Val) -> Path Val (flagIf pu1 (flagIf pu3 pa pc) (flagIf pu2 pa pk)) (flagIf pu2 (flagIf pu4 pc pa) (flagIf pu1 pc pk)) := fun (pu1 : Flag) (pu2 : Flag) (pu3 : Flag) (pu4 : Flag) (pn12 : Path Flag pu1 flagYes -> Path Flag pu2 flagYes -> Path Flag flagNo flagYes) (pn3 : Path Flag pu3 flagYes -> Path Flag flagNo flagYes) (pn4 : Path Flag pu4 flagYes -> Path Flag flagNo flagYes) (pa : Val) (pc : Val) (pk : Val) => elim (fun (pt : Flag) => (Path Flag pt flagYes -> Path Flag pu2 flagYes -> Path Flag flagNo flagYes) -> Path Val (flagIf pt (flagIf pu3 pa pc) (flagIf pu2 pa pk)) (flagIf pu2 (flagIf pu4 pc pa) (flagIf pt pc pk))) (fun (pm : Path Flag flagYes flagYes -> Path Flag pu2 flagYes -> Path Flag flagNo flagYes) => elim (fun (pt : Flag) => (Path Flag pt flagYes -> Path Flag flagNo flagYes) -> Path Val (flagIf pu3 pa pc) (flagIf pt (flagIf pu4 pc pa) pc)) (fun (pq : Path Flag flagYes flagYes -> Path Flag flagNo flagYes) => flagAbsurd Val (flagIf pu3 pa pc) (flagIf pu4 pc pa) (pq refl)) (fun (pq : Path Flag flagNo flagYes -> Path Flag flagNo flagYes) => valCase pu3 pn3 pa pc) pu2 (pm refl)) (fun (pm : Path Flag flagNo flagYes -> Path Flag pu2 flagYes -> Path Flag flagNo flagYes) => elim (fun (pt : Flag) => Path Val (flagIf pt pa pk) (flagIf pt (flagIf pu4 pc pa) pk)) (valCaseR pu4 pn4 pc pa) refl pu2) pu1 pn12
def payBranch : (pa : Size) -> (pb : Size) -> (pc : Size) -> (pd : Size) -> Path Flag (flagIf (keyEq (Bal pa) (Bal pd)) flagNo flagYes) flagYes -> Path Flag (flagIf (keyEq (Bal pb) (Bal pc)) flagNo flagYes) flagYes -> Path Flag (flagIf (keyEq (Bal pb) (Bal pd)) flagNo flagYes) flagYes -> (ps : State) -> Path (Maybe State) (effSeq (stepPay (mk pa pb)) (stepPay (mk pc pd)) ps) (effSeq (stepPay (mk pc pd)) (stepPay (mk pa pb)) ps) := fun (pa : Size) (pb : Size) (pc : Size) (pd : Size) (ph1 : Path Flag (flagIf (keyEq (Bal pa) (Bal pd)) flagNo flagYes) flagYes) (ph2 : Path Flag (flagIf (keyEq (Bal pb) (Bal pc)) flagNo flagYes) flagYes) (ph3 : Path Flag (flagIf (keyEq (Bal pb) (Bal pd)) flagNo flagYes) flagYes) (ps : State) => cong (fun (pst : State) => some pst) (funExt (fun (pkk : Key) => valPoint (keyEq pkk (Bal pd)) (keyEq pkk (Bal pb)) (keyEq (Bal pc) (Bal pb)) (keyEq (Bal pa) (Bal pd)) (fun (pe1 : Path Flag (keyEq pkk (Bal pd)) flagYes) (pe2 : Path Flag (keyEq pkk (Bal pb)) flagYes) => swapKill (keyEq (Bal pb) (Bal pd)) ph3 (keyMeet pkk (Bal pb) (Bal pd) pe1 pe2)) (fun (pe3 : Path Flag (keyEq (Bal pc) (Bal pb)) flagYes) => swapKill (keyEq (Bal pb) (Bal pc)) ph2 (keySym (Bal pc) (Bal pb) pe3)) (fun (pe4 : Path Flag (keyEq (Bal pa) (Bal pd)) flagYes) => swapKill (keyEq (Bal pa) (Bal pd)) ph1 pe4) (ps (Bal pa)) (ps (Bal pc)) (ps pkk)))
def commutePayPay : (f : Pay) -> (g : Pay) -> Path Flag (ind (bodyPay f) (bodyPay g)) flagYes -> (s : State) -> Path (Maybe State) (effSeq (step (bodyPay f)) (step (bodyPay g)) s) (effSeq (step (bodyPay g)) (step (bodyPay f)) s) :=
  fun (f : Pay) => elim (fun (u : Pay) => (g : Pay) -> Path Flag (ind (bodyPay u) (bodyPay g)) flagYes -> (s : State) -> Path (Maybe State) (effSeq (step (bodyPay u)) (step (bodyPay g)) s) (effSeq (step (bodyPay g)) (step (bodyPay u)) s))
    (fun (a : Size) (b : Size) (g : Pay) => elim (fun (v : Pay) => Path Flag (ind (bodyPay (mk a b)) (bodyPay v)) flagYes -> (s : State) -> Path (Maybe State) (effSeq (step (bodyPay (mk a b))) (step (bodyPay v)) s) (effSeq (step (bodyPay v)) (step (bodyPay (mk a b))) s))
      (fun (c : Size) (d : Size) (h : Path Flag (ind (bodyPay (mk a b)) (bodyPay (mk c d))) flagYes) =>
        payBranch a b c d (flagAndRight (keyApart (Bal b) (Bal d)) (keyApart (Bal a) (Bal d)) (flagAndRight (keyApart (Bal b) (Bal c)) (flagBoth (keyApart (Bal b) (Bal d)) (keyApart (Bal a) (Bal d))) h)) (flagAndLeft (keyApart (Bal b) (Bal c)) (flagBoth (keyApart (Bal b) (Bal d)) (keyApart (Bal a) (Bal d))) h) (flagAndLeft (keyApart (Bal b) (Bal d)) (keyApart (Bal a) (Bal d)) (flagAndRight (keyApart (Bal b) (Bal c)) (flagBoth (keyApart (Bal b) (Bal d)) (keyApart (Bal a) (Bal d))) h))) g) f
def payA : Body := bodyPay (mk sz0 (szS sz0))
def payB : Body := bodyPay (mk (szS (szS sz0)) (szS (szS (szS sz0))))
def tAB : Trace := traceCons payA (traceCons payB traceEps)
def tSwap : Path Trace tAB (traceCons payB (traceCons payA traceEps)) :=
  fun (i : I) => traceSwap payA payB traceEps refl i
def cAB : Path Eff (effSeq (step payA) (step payB)) (effSeq (step payB) (step payA)) := commute payA payB refl

-- D is the negation of ind (S6 u8, Q-S6-41 (a)). Eval rows: depAB, depAA.
def depAB : Flag := D payA payB
def depAA : Flag := D payA payA
def fpayA : Body := bodyPay (mk sz0 (szS sz0))
def fpayB : Body := bodyPay (mk (szS sz0) (szS (szS sz0)))
def fpayC : Body := bodyPay (mk (szS (szS sz0)) (szS (szS (szS sz0))))
def fcastA : Body := bodyCast (mkcast sz0)
def fcastB : Body := bodyCast (mkcast (szS sz0))
def stepInd : Path (List (List Body)) (foata (cons fpayA (cons fcastA nil))) (cons (cons fpayA (cons fcastA nil)) nil) := refl
def stepDep : Path (List (List Body)) (foata (cons fpayA (cons fpayB nil))) (cons (cons fpayA nil) (cons (cons fpayB nil) nil)) := refl
def stepMix : Path (List (List Body)) (foata (cons fpayA (cons fcastA (cons fpayB nil)))) (cons (cons fpayA (cons fcastA nil)) (cons (cons fpayB nil) nil)) := refl
def eqInd : Path Flag (foataEq (cons fpayA (cons fcastA nil)) (cons fcastA (cons fpayA nil))) flagYes := refl
def eqIfYes : Path Flag (foataEq (cons fpayA (cons fpayC nil)) (cons fpayC (cons fpayA nil))) flagYes := refl
def eqIfNo : Path Flag (foataEq (cons fpayA (cons fpayB nil)) (cons fpayB (cons fpayA nil))) flagNo := refl
def eqDep : Path Flag (foataEq (cons fcastA (cons fcastB nil)) (cons fcastB (cons fcastA nil))) flagNo := refl
def eqLength : Path Flag (foataEq (cons fcastA (cons fcastA nil)) (cons fcastA nil)) flagNo := refl

-- traceLe and compatible (S7 u5b, Q-S7-14 (a)): traceResidual walks the
-- first list in order. A body is common when it is ind of each earlier
-- body of the first residual and traceRemove removes an equal body of the
-- second list that is ind of each earlier remaining body. traceLe is
-- flagYes when the first residual is empty. compatible is flagYes when
-- each body of the first residual is ind of each body of the second
-- residual. fpayA and fpayB are a dep pair, thus compOrder is flagNo.
-- Eval rows: leInd, leIfYes, leDep, leMiss, compInd, compPrefix, compDep,
-- compOrder.
def leInd : Flag := traceLe (cons fcastA nil) (cons fpayA (cons fcastA nil))
def leIfYes : Flag := traceLe (cons fpayC nil) (cons fpayA (cons fpayC nil))
def leDep : Flag := traceLe (cons fpayB nil) (cons fpayA (cons fpayB nil))
def leMiss : Flag := traceLe (cons fcastB nil) (cons fcastA nil)
def compInd : Flag := compatible (cons fpayA nil) (cons fcastA nil)
def compPrefix : Flag := compatible (cons fpayA nil) (cons fpayA (cons fpayB nil))
def compDep : Flag := compatible (cons fpayA nil) (cons fpayB nil)
def compOrder : Flag := compatible (cons fpayA (cons fpayB nil)) (cons fpayB nil)
def leIndRow : Path Flag leInd flagYes := refl
def leIfYesRow : Path Flag leIfYes flagYes := refl
def leDepRow : Path Flag leDep flagNo := refl
def leMissRow : Path Flag leMiss flagNo := refl
def compIndRow : Path Flag compInd flagYes := refl
def compPrefixRow : Path Flag compPrefix flagYes := refl
def compDepRow : Path Flag compDep flagNo := refl
def compOrderRow : Path Flag compOrder flagNo := refl
