-- Base signature slots have type Type 0. The action below is an
-- ordinary program function over three slots.
def Owner : Type 0 := Sum Unit Unit
def Answer : Type 0 := Sum Unit Unit
def Query : Type 0 := Sum Unit Unit

def flip : Answer -> Answer := fun (c : Answer) => either (fun (u : Unit) => inr unit) (fun (u : Unit) => inl unit) c

def act : Query -> (Owner -> Answer) -> Owner -> Answer :=
  fun (g : Query) (f : Owner -> Answer) (m : Owner) => either (fun (u : Unit) => f m) (fun (u : Unit) => flip (f m)) g

def flipped : Answer := act (inr unit) (fun (m : Owner) => inl unit) (inl unit)
def kept : Answer := act (inl unit) (fun (m : Owner) => inl unit) (inl unit)
