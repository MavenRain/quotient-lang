-- S5 u4 item 7 (X17): a get pattern that is not in the reads of the
-- footprint gives REFUSE_FOOTPRINT_READ. The reads have Cfg(b.to, lim),
-- not Cfg(b.from, lim). The step binder p is renamed to b.
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Cfg : Size -> Size -> Key
def lim : Size := szS sz0
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from), Bal(b.to), Cfg(b.to, lim)] writes [Bal(b.to)]
step Pay p := [get x := Bal(p.from), get y := Cfg(p.from, lim), set Bal(p.to) := x]
