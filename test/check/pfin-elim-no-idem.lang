-- An elim out of Pfin needs a motive, one case for each constructor and a
-- scrutinee. This elim has no pfinIdem case, the idempotent clause (law
-- L2), so it gives REFUSE_BAG_NONCOMM (S3, USER ruling Q-S2-4 (a)).
def f : Pfin Size -> Pfin Size := fun (b : Pfin Size) => elim (fun (t : Pfin Size) => Pfin Size) (fun (h : Size) => pfinOf Size h) (pfinUnit Size) (fun (l : Pfin Size) (ihl : Pfin Size) (r : Pfin Size) (ihr : Pfin Size) => pfinOp Size ihl ihr) (fun (x : Pfin Size) (ihx : Pfin Size) (y : Pfin Size) (ihy : Pfin Size) (z : Pfin Size) (ihz : Pfin Size) => fun (i : I) => pfinAssoc Size ihx ihy ihz i) (fun (x : Pfin Size) (ihx : Pfin Size) (y : Pfin Size) (ihy : Pfin Size) => fun (i : I) => pfinComm Size ihx ihy i) (fun (x : Pfin Size) (ihx : Pfin Size) => fun (i : I) => pfinUnitL Size ihx i) (fun (x : Pfin Size) (ihx : Pfin Size) (y : Pfin Size) (ihy : Pfin Size) (p : Path (Pfin Size) x y) (ihp : Path (Pfin Size) ihx ihy) (q : Path (Pfin Size) x y) (ihq : Path (Pfin Size) ihx ihy) => fun (i : I) => fun (j : I) => pfinSquash Size ihx ihy ihp ihq i j) b
