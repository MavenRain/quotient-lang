-- S5 u4 item 7 (X17, Q-S5-21 (a)): a pattern argument that is a name
-- bound by a let is dynamic too and gives REFUSE_FOOTPRINT_DYNAMIC.
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Cfg : Size -> Size -> Key
def lim : Size := szS sz0
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from), Bal(b.to), Cfg(b.to, lim)] writes [Bal(b.to)]
step Pay p := [get x := Bal(p.from), let y := x, set Bal(y) := x]
