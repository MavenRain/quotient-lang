-- effAssoc is a domain definition: the prelude step text has it
-- (Q-S6-28 (a)). A user def with the same name gives REFUSE_NAME (rule R4).
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Vote : Size -> Key
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from)] writes [Bal(b.to)]
family Cast := mkcast (voter : Size) footprint b reads [Vote(b.voter)] writes [Vote(b.voter)]
def tEff : isSet Eff := effIsSet
def tTrace : isSet Trace := traceIsSet
def tSize : isSet Size := sizeIsSet
def tMaybe : isSet (Maybe Size) := maybeIsSet Size sizeIsSet
def effAssoc : (f : Eff) -> (g : Eff) -> (h : Eff) -> Path Eff (effSeq (effSeq f g) h) (effSeq f (effSeq g h)) :=
  fun (f : Eff) (g : Eff) (h : Eff) => fun (i : I) => fun (s : State) =>
    elim (fun (z : Maybe State) => Path (Maybe State) (bind (bind z (fun (t : State) => g t)) (fun (t : State) => h t)) (bind z (fun (t : State) => bind (g t) (fun (u : State) => h u))))
      (fun (j : I) => none)
      (fun (c : State) => fun (j : I) => bind (g c) (fun (u : State) => h u))
      (f s) @ i
def tAssoc : Path Eff (effSeq (effSeq just just) just) (effSeq just (effSeq just just)) := effAssoc just just just
