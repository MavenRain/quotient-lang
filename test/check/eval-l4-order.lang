-- evalAppend gives the eval of traceAppend t u as effSeq (traceEval t)
-- (traceEval u): the eval of t comes first. This row has the order
-- reversed: the end points do not convert, and the check gives PATH_END
-- at tL4bad.
def Val : Type 0 := Size
keyspace Bal : Size -> Key
keyspace Vote : Size -> Key
family Pay := mk (from : Size) (to : Size) footprint b reads [Bal(b.from)] writes [Bal(b.to)]
family Cast := mkcast (voter : Size) footprint b reads [Vote(b.voter)] writes [Vote(b.voter)]
def tEff : isSet Eff := effIsSet
def tTrace : isSet Trace := traceIsSet
def tSize : isSet Size := sizeIsSet
def tMaybe : isSet (Maybe Size) := maybeIsSet Size sizeIsSet
def tL4bad : (a : Body) -> (b : Body) -> Path Eff (traceEval (traceAppend (traceOne a) (traceOne b))) (effSeq (traceEval (traceOne b)) (traceEval (traceOne a))) :=
  fun (a : Body) (b : Body) => refl
